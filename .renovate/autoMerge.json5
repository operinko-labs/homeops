{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // Every tier merges through a PR that Forgejo itself merges once CI passes
  // (platformAutomerge, set in .renovaterc.json5). Never automergeType
  // "branch" or ignoreTests: when Renovate merges something itself it restarts
  // the repo job once and stops after the next self-merge. That allows two
  // merges per run and skips the dashboard update.
  packageRules: [
    // --- Tier 1: Trusted sources, auto-merge without an age gate -------------
    {
      description: "Auto-merge trusted container digests (home-operations)",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Auto-merge trusted GitHub Actions (actions/*, renovatebot/*)",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\//", "/^renovatebot\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "1 minute",
    },
    {
      // Tracked by the "Renovate self-update" regex manager (github-releases),
      // so the github-actions rule above never matches it. Upstream ships
      // several releases a day (one PR saw 9 force-pushes in 2 days), so the
      // branch is only created/updated in a nightly window: at most one merge
      // and one 1.3GB image pull per runner per day. Stale images are cleared
      // by the runners' weekly docker-prune.
      description: "Auto-merge Renovate self-update (minor/patch), nightly",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["renovatebot/renovate"],
      matchUpdateTypes: ["minor", "patch"],
      schedule: ["after 10pm and before 4am every day"],
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Auto-merge other GitHub Actions (minor/patch)",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "pr",
      minimumReleaseAge: "3 days",
    },
    {
      description: "Auto-merge CLI tools (mise-managed, patch only)",
      matchDatasources: ["github-releases"],
      matchManagers: ["mise"],
      matchUpdateTypes: ["patch"],
      automerge: true,
      automergeType: "pr",
    },
    // --- Tier 2: Container patches with safety gates ---
    {
      description: "Auto-merge container patch/digest with release age gate",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["patch", "digest"],
      minimumReleaseAge: "3 days",
      automerge: true,
      automergeType: "pr",
    },
    {
      description: "Auto-merge trusted github-releases (minor/patch)",
      matchDatasources: ["github-releases"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/external-dns/", "/gateway-api/", "/prometheus-operator/"],
      automerge: true,
      automergeType: "pr",
    },
    // --- Tier 2.5: Container/chart minors, age-gated AND test-gated ----------
    {
      description: "Auto-merge container/chart minors (age gate + CI must pass)",
      matchDatasources: ["docker", "helm"],
      matchUpdateTypes: ["minor"],
      minimumReleaseAge: "3 days",
      automerge: true,
      automergeType: "pr",
    },
    // registryAliases send every docker lookup through Harbor, which gives
    // Renovate no release timestamps. With the default "timestamp-required"
    // the 3-day minimumReleaseAge above can then never pass, and patch/minor
    // updates sat in "Pending Status Checks" for weeks. "timestamp-optional"
    // treats an undated release as stable. Rolled out in batches (2026-11-19);
    // this list goes away once every docker package is covered.
    {
      description: "Undated (Harbor-proxied) docker releases count as stable",
      matchDatasources: ["docker"],
      matchPackageNames: [
        // batch 1: apps
        "/home-operations/(sonarr|radarr|prowlarr|bazarr|tautulli)$/",
        "/maintainerr/",
        "/spot+arr/",
        "/seerr-team/seerr$/",
        "/wizarrrr/wizarr$/",
        "/raydak-labs/configarr$/",
        "/gethomepage/homepage$/",
        "/twin/gatus$/",
        "/binwiederhier/ntfy$/",
        "/unpoller/unpoller$/",
        "/advplyr/audiobookshelf$/",
        "/hargata/lubelogger$/",
        "/tphakala/birdnet-go$/",
        "/bulwarkmail/webmail$/",
        "/gramps-project/grampsweb$/",
        "/caddy$/",
        "/nginx-unprivileged$/",
      ],
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    // --- Tier 3: Majors stay as manual-review PRs (Renovate default) ---------

    // --- Never auto-merge, whatever the tiers above say ----------------------
    // Must stay last: packageRules are applied in order and the later rule wins.
    {
      description: "Talos and kubelet are never auto-merged - they reboot nodes / upgrade the cluster",
      // Regex, so it matches both the ghcr.io name and the registryAliases-
      // rewritten harbor.vaderrp.com/ghcr form.
      matchPackageNames: ["/siderolabs/"],
      automerge: false,
    },
  ],
}
