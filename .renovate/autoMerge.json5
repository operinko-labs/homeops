{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    // --- Tier 1: Trusted sources, auto-merge immediately via branch (no PR) ---
    {
      description: "Auto-merge trusted container digests (home-operations)",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["digest"],
      matchPackageNames: ["/home-operations/"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted GitHub Actions (actions/*, renovatebot/*)",
      matchManagers: ["github-actions"],
      matchPackageNames: ["/^actions\//", "/^renovatebot\//"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "1 minute",
      ignoreTests: true,
    },
    {
      // Tracked by the "Renovate self-update" regex manager (github-releases),
      // so the github-actions rule above never matches it. Upstream ships
      // several minors a week; merge them straight to main, no PR.
      description: "Auto-merge Renovate self-update (minor/patch)",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["renovatebot/renovate"],
      matchUpdateTypes: ["minor", "patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    {
      description: "Auto-merge other GitHub Actions (minor/patch)",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "3 days",
      ignoreTests: true,
    },
    {
      description: "Auto-merge CLI tools (mise-managed, patch only)",
      matchDatasources: ["github-releases"],
      matchManagers: ["mise"],
      matchUpdateTypes: ["patch"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    // --- Tier 2: Container patches with safety gates ---
    {
      description: "Auto-merge container patch/digest with release age gate",
      matchDatasources: ["docker"],
      matchUpdateTypes: ["patch", "digest"],
      minimumReleaseAge: "3 days",
      automerge: true,
      automergeType: "pr",
      ignoreTests: true,
    },
    {
      description: "Auto-merge trusted github-releases (minor/patch)",
      matchDatasources: ["github-releases"],
      matchUpdateTypes: ["minor", "patch"],
      matchPackageNames: ["/external-dns/", "/gateway-api/", "/prometheus-operator/"],
      automerge: true,
      automergeType: "branch",
      ignoreTests: true,
    },
    // --- Tier 2.5: Container/chart minors, age-gated AND test-gated ----------
    {
      description: "Auto-merge container/chart minors (age gate + CI must pass)",
      matchDatasources: ["docker", "helm"],
      matchUpdateTypes: ["minor"],
      minimumReleaseAge: "3 days",
      automerge: true,
      automergeType: "pr",
      // no ignoreTests here: lint/kubeconform on the PR must be green before
      // Renovate merges (unlike the older tiers, which predate Forgejo CI)
    },
    // --- Tier 3: Majors stay as manual-review PRs (Renovate default) ---------

    // --- Never auto-merge, whatever the tiers above say ----------------------
    // Must stay last: packageRules are applied in order and the later rule wins.
    {
      description: "Talos and kubelet are never auto-merged - they reboot nodes / upgrade the cluster",
      // Regex, so it matches both the ghcr.io name and the registryAliases-
      // rewritten harbor.vaderrp.com/ghcr form.
      matchPackageNames: ["/siderolabs/"],
      automerge: false,
    },
  ],
}
