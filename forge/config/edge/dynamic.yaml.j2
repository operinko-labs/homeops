---
# Rendered by `just forge apply-edge` from routes.yaml + forge/secrets.sops.yaml
# into /etc/traefik/dynamic/edge.yaml. Traefik's file provider reloads it on change.
http:
  routers:
{% for r in edge_routes %}
    {{ r.name }}:
      rule: "Host(`{{ r.host }}`)"
      entryPoints: [websecure{% if r.wan %}, wan{% endif %}]
      service: {{ r.name }}
{# Router middlewares apply on every entrypoint, so a wan route (public by
   definition) must not carry lan-only or the VPS path would get 403. #}
{% if r.auth == "oidc" %}
      middlewares: [oidc-auth]
    # LAN clients (socket IP, like lan-only) never enter the OIDC plugin: it
    # runs Authentik discovery before any bypass and answers 500 when the
    # cluster is down, which is when PBS/Proxmox matter most. The longer rule
    # outranks the oidc router above.
    {{ r.name }}-lan:
      rule: "Host(`{{ r.host }}`) && ClientIP(`192.168.0.0/16`)"
      entryPoints: [websecure]
      service: {{ r.name }}
{% elif not r.public and not r.wan %}
      middlewares: [lan-only]
{% endif %}
{% endfor %}
    # Read-only overview of everything above (LAN only, plus a login)
    dashboard:
      rule: "Host(`edge.vaderrp.com`)"
      entryPoints: [websecure]
      service: api@internal
      middlewares: [lan-only, dashboard-auth]
  services:
{% for r in edge_routes %}
    {{ r.name }}:
      loadBalancer:
{% if r.insecure %}
        serversTransport: insecure
{% endif %}
        servers:
          - url: "{{ r.url }}"
{% endfor %}
  middlewares:
    # Attached to the websecure entrypoint (traefik.yaml). Refreshes
    # Cloudflare's published ranges itself; cloudflare-only avoids the
    # CloudFront fetch that stalled the cluster's reloads.
    real-ip:
      plugin:
        traefikwarp:
          provider: cloudflare
          autoRefresh: true
          refreshInterval: 24h
    # Authentik login for routes marked auth: oidc, reached only by non-LAN
    # clients (LAN traffic takes the <name>-lan router instead). Reuses the
    # cluster's "traefik" application (its redirect URIs allow any
    # https://*.vaderrp.com/oidc/callback); deliberately no bypass rule and no
    # API-path exemptions.
    oidc-auth:
      plugin:
        traefik-oidc-auth:
          LogLevel: WARN
          Secret: {{ edge_oidc_encryption_secret | tojson }}
          Provider:
            Url: "https://auth.vaderrp.com/application/o/traefik/"
            ClientId: {{ edge_oidc_client_id | tojson }}
            ClientSecret: {{ edge_oidc_client_secret | tojson }}
          Scopes: ["openid", "profile", "email"]
          CallbackUri: "/oidc/callback"
    lan-only:
      ipAllowList:
        sourceRange: ["192.168.0.0/16"]
    dashboard-auth:
      basicAuth:
        users: ["{{ edge_dashboard_htpasswd }}"]
  serversTransports:
    # Self-signed backends (cups, vaultwarden, pbs, technitium)
    insecure:
      insecureSkipVerify: true

tcp:
  routers:
    ssh:
      rule: "HostSNI(`*`)"
      entryPoints: [ssh]
      service: forgejo-ssh
  services:
    forgejo-ssh:
      loadBalancer:
        servers:
          - address: "192.168.7.30:22"

# Written by lego's deploy hook (edge-cert-hook.sh); Traefik picks the
# certificate by SNI and falls back to the wildcard.
tls:
  certificates:
    - certFile: /etc/edge/certs/_.vaderrp.com/fullchain.pem
      keyFile: /etc/edge/certs/_.vaderrp.com/privkey.pem
    - certFile: /etc/edge/certs/_.dns.vaderrp.com/fullchain.pem
      keyFile: /etc/edge/certs/_.dns.vaderrp.com/privkey.pem
  stores:
    default:
      defaultCertificate:
        certFile: /etc/edge/certs/_.vaderrp.com/fullchain.pem
        keyFile: /etc/edge/certs/_.vaderrp.com/privkey.pem
