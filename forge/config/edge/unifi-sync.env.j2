# Rendered by `just forge apply-edge` into /etc/edge/unifi-sync.env (0600).
# The key is a UniFi local API key used only by cf-unifi-sync; while it is
# absent from forge/secrets.sops.yaml the daily sync stays off.
UNIFI_API_KEY={{ edge_unifi_api_key | default("") }}
# UniFi address group "Cloudflare IPv4", the source limit on the WAN :443
# port forward "HTTPS to edge (Cloudflare only)".
UNIFI_GROUP_ID=a89e561c-aaab-4ed5-88a5-1845be1d88d5
