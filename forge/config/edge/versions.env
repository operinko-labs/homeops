# Pinned binaries for the edge LXC; installed by forge/apply-edge.sh.
# renovate: datasource=github-releases depName=traefik/traefik
TRAEFIK_VERSION=v3.7.19
# renovate: datasource=github-releases depName=go-acme/lego
LEGO_VERSION=v5.6.0
# Traefik local plugin (real client IP behind Cloudflare); same pin as the cluster
# renovate: datasource=github-releases depName=l4rm4nd/traefik-warp
TRAEFIK_WARP_VERSION=v1.1.5
# Traefik local plugin (Authentik login for auth: oidc routes); same pin as the cluster
# renovate: datasource=github-releases depName=sevensolutions/traefik-oidc-auth
TRAEFIK_OIDC_AUTH_VERSION=v0.22.0
# CrowdSec engine + cscli (static binaries from crowdsec-release.tgz)
# renovate: datasource=github-releases depName=crowdsecurity/crowdsec
CROWDSEC_VERSION=v1.8.2
