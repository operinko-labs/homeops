customization:
    extraKernelArgs:
        - mitigations=off
        - talos.auditd.disabled=1
        - sysctl.kernel.kexec_load_disabled=1
    systemExtensions:
        officialExtensions:
            - siderolabs/intel-ucode
            - siderolabs/iscsi-tools
            - siderolabs/nfsrahead
            - siderolabs/nut-client
            - siderolabs/qemu-guest-agent
    bootloader: grub
