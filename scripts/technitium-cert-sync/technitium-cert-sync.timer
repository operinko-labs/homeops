[Unit]
Description=Hourly Technitium TLS bundle sync from the edge proxy

[Timer]
OnBootSec=2min
OnUnitActiveSec=1h
# lego on the edge LXC renews the 90-day certificate about 30 days before
# expiry; hourly keeps the nodes within an hour of it and is nearly free —
# the script exits early when the source has not changed.
RandomizedDelaySec=5min
# Both nodes run this; without a jitter they would hit the edge LXC together.
Persistent=true

[Install]
WantedBy=timers.target
